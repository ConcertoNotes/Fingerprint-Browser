# 复制本文件为 .env 后再修改：
#   cp .env.example .env && chmod 600 .env
#
# 1) 你的云服务域名（不要带 https://，需先在域名服务商处添加 A 记录指向本 VPS 的公网 IP）
PRISM_CLOUD_DOMAIN=cloud.example.com

# 2) 管理员后台 (/admin) 与管理 API (/v1/admin/*) 的登录密钥
#    请务必替换为高强度随机密码，例如运行：
#      openssl rand -hex 24
PRISM_CLOUD_ADMIN_TOKEN=REPLACE_WITH_STRONG_ADMIN_TOKEN

# 3) 服务端数据库加密密钥（44 位标准 Fernet 密钥，用于加密存储上游机场链接、节点密文与会话签名）
#    请使用下面任一命令生成（任选其一即可）：
#      python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#      openssl rand 32 | base64 | tr '+/' '-_'
#    若留空，服务端首次启动时会在 /data/cloud_secret.key 自动生成（请务必一并备份 /data 目录）。
PRISM_CLOUD_SECRET_KEY=REPLACE_WITH_44_CHAR_FERNET_KEY

# 4) [可选 · 仅旧版单租户兼容] 多租户客户交付场景请保持注释状态！
#    请在 https://<你的域名>/admin 后台为每位客户单独生成专属授权码（prism_...）。
# PRISM_CLOUD_TOKEN=
